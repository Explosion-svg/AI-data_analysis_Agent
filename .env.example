# ═══════════════════════════════════════════════════════════════
#  AI Data Analysis Agent — Environment Configuration
#  Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────
APP_NAME="AI Data Analysis Agent"
APP_VERSION="1.0.0"
ENV=dev                  # dev | staging | prod
DEBUG=false
HOST=0.0.0.0
PORT=8000
WORKERS=1

# API protection (leave empty to disable auth)
API_KEY=

# ── CORS ─────────────────────────────────────────────────────
# 注意：CORS_ALLOW_CREDENTIALS=true 与 CORS_ALLOW_ORIGINS="*" 不能同时使用
#（CORS 规范禁止，配置加载时会直接报错）。开启 credentials 时必须列出具体域名。
CORS_ALLOW_ORIGINS=*            # 逗号分隔，如 https://app.example.com
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# ── Data Warehouse (OLAP) ─────────────────────────────────────
# SQL 工具执行 SELECT 查询的分析数据库。
# SQLite (default, for development)
WAREHOUSE_URL=sqlite+aiosqlite:///./data/warehouse.db

# ClickHouse example:
# WAREHOUSE_URL=clickhouse+asynch://user:password@localhost:8123/default

# ── Vector Store ──────────────────────────────────────────────
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_DOCS_COLLECTION=docs
CHROMA_SCHEMA_COLLECTION=schema

# ── LLM — OpenAI ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini

# ── LLM — DeepSeek (optional) ────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ── LLM — Anthropic Claude (optional) ────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── LLM — Local (Ollama / LM Studio, optional) ───────────────
LOCAL_LLM_API_BASE=
LOCAL_LLM_MODEL=

# ── LLM Common ───────────────────────────────────────────────
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60.0
LLM_MAX_RETRIES=3

# ── Embedding ─────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ── Reliability ───────────────────────────────────────────────
SQL_QUERY_TIMEOUT=30.0
PYTHON_EXEC_TIMEOUT=20.0
AGENT_MAX_ITERATIONS=10
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60.0
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=30.0

# Concurrency / Bulkhead
# 下面是一套适合作为“单实例初始生产基线”的保守参数：
# - 适合 2~4 CPU、单实例、多数请求依赖外部 LLM 的场景
# - 先用这组值起步，再结合 run_load_test.py 的 p95/p99 和 503 比例调参
AGENT_REQUEST_CONCURRENCY=64
LLM_CONCURRENCY=16
EMBEDDING_CONCURRENCY=32
TOOL_CONCURRENCY=32
SQL_TOOL_CONCURRENCY=16
PYTHON_TOOL_CONCURRENCY=8
RAG_TOOL_CONCURRENCY=16
CHART_TOOL_CONCURRENCY=8
SCHEMA_TOOL_CONCURRENCY=16
CONCURRENCY_ACQUIRE_TIMEOUT_SECONDS=1.0
EXECUTOR_MAX_PARALLEL_STEPS=3
AGENT_ENABLE_PLANNING=true
AGENT_FORCE_GROUNDED_ANSWER=true

# ── Memory / Cache ────────────────────────────────────────────
CONVERSATION_MAX_TURNS=20
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=256
MEMORY_BACKEND=redis          # memory | redis
CACHE_BACKEND=redis           # memory | redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_PREFIX=ai_data_agent:cache
REDIS_WORK_PREFIX=ai_data_agent:work
REDIS_CONVERSATION_PREFIX=ai_data_agent:conversation
REDIS_WORK_TTL_SECONDS=86400
REDIS_CONVERSATION_TTL_SECONDS=604800
REDIS_SOCKET_TIMEOUT=2.0
REDIS_CONNECT_TIMEOUT=2.0
REDIS_HEALTH_CHECK_INTERVAL=30
REDIS_RETRY_ON_TIMEOUT=true
REDIS_CACHE_FAIL_OPEN=true
REDIS_CACHE_STARTUP_CHECK=true
REDIS_OPTIMISTIC_LOCK_RETRIES=3

# ── Observability ─────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=true
ENABLE_TRACING=false
OTLP_ENDPOINT=               # e.g. http://jaeger:4317
ENABLE_METRICS=true
METRICS_PORT=9090

# ── Security ──────────────────────────────────────────────────
SQL_READONLY=true            # Only allow SELECT statements
